# ==============================================
# FleetPulse Environment Configuration (.env.example)
# Copy this file to .env and adjust variables as needed
# ==============================================

# Core Settings
DEBUG=True
SECRET_KEY=django-insecure-fleetpulse-dev-secret-key-change-in-production!
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Connection URL
# ----------------------------------------------
# Default: Local SQLite database
DATABASE_URL=sqlite:///db.sqlite3

# To connect to PostgreSQL, uncomment and configure:
# DATABASE_URL=postgres://fleet_user:secret_password@localhost:5432/fleetpulse_db
